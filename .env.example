# Firebase web app config (Project Settings → General → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Extra Google accounts that may sign in.
# @beginthework.com is always allowed in the app and security rules.
# Add the client workspace domain here (comma-separated, no @).
VITE_ALLOWED_DOMAINS=
VITE_ALLOWED_EMAILS=
